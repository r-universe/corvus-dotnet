[submodule ".registry"]
	path = .registry
	url = https://github.com/corvus-dotnet/corvus-dotnet.r-universe.dev
	branch = HEAD
[submodule "corvusjsonschema"]
	path = corvusjsonschema
	url = https://github.com/corvus-dotnet/Corvus.JsonSchema
	branch = r-release
	subdir = src-r/corvusjsonschema
[submodule "corvusregexecma262"]
	path = corvusregexecma262
	url = https://github.com/corvus-dotnet/corvus-regex-ecma262-r
	branch = v0.2.1
